/budget/* /budget/index.html 200

# Canonical host: non-www. Cloudflare Pages' _redirects file does not
# support domain-level/host-based redirects (confirmed against current
# Cloudflare Pages documentation — Bulk Redirects or the dashboard is
# required for that). The www -> non-www redirect is already configured
# directly in the Cloudflare dashboard; do not duplicate it here.

# salary-to-hourly consolidated into salary-vs-hourly (AdSense audit
# Phase 1) — orphaned duplicate page, redirect to the canonical URL.
/salary-to-hourly/* /salary-vs-hourly/ 301
/salary-to-hourly /salary-vs-hourly/ 301

# Development-only files are kept in the repo but must not be served as
# public site content. Cloudflare Pages applies _redirects even when a
# file exists at the path, so these never reach visitors or crawlers.
# (Pages _redirects cannot return a 404 status, hence the redirect.)
/template / 301
/template/* / 301
/tests / 301
/tests/* / 301
/README.md / 301
/YEARLY_UPDATE.md / 301
/folders.txt / 301
/favicon_update.py / 301
/file.jpe / 301
